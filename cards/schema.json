{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Карточка заказчика riskpipe",
  "type": "object",
  "required": ["eid", "name", "color", "action", "coverage", "missing", "flags", "run_id", "origin"],
  "properties": {
    "eid": {"type": "string", "pattern": "^(ul|fl)\\??:"},
    "inn": {"type": ["string", "null"], "pattern": "^(\\d{10}|\\d{12})$"},
    "name": {"type": "string", "minLength": 1},
    "color": {"enum": ["red", "yellow", "green", "grey"]},
    "profile": {"enum": ["коммерческое", "учреждение", "унитарное"]},
    "action": {"type": "string", "minLength": 1},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "missing": {"type": "array", "items": {"type": "string"}},
    "unavailable": {"type": "object"},
    "group": {"type": "array", "items": {"type": "string"}},
    "tender": {"type": ["object", "null"]},
    "origin": {"type": "string"},
    "run_id": {"type": "string"},
    "explain": {"type": "string"},
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "level", "kind", "text", "url", "observed", "src_class"],
        "properties": {
          "rule": {"type": "string"},
          "level": {"enum": ["red", "yellow", "info"]},
          "kind": {"enum": ["fact", "fact2", "hypothesis"]},
          "text": {"type": "string"},
          "url": {"type": "string", "pattern": "^https?://"},
          "observed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "src_class": {"enum": ["official", "licensed", "aggregator", "company_site", "media"]},
          "via": {"type": "string"}
        }
      }
    }
  },
  "x-rules": [
    "красный флаг не может иметь kind=hypothesis (СМИ сами по себе дают максимум жёлтый)",
    "green только без red/yellow флагов и при coverage >= 0.8",
    "grey для неопознанных (eid с '?') независимо от флагов"
  ]
}
