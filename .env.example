# Скопируйте в .env (рядом с этим файлом) и заполните. .env в git не попадает.

# Checko API — суды (дела за 12 мес), ФССП, санкции, дочки. https://checko.ru → регистрация → раздел «API».
# Бесплатно ~100 запросов/сутки (≈33 компании: 3 запроса на компанию). Без ключа суды и ФССП не проверяются.
CHECKO_API_KEY=

# Необязательно: путь к исходникам mOS (папки mOS_vault/ и mos/), если методика должна браться оттуда,
# а не из methodology/ этого репозитория.
# MOS_ROOT=/opt/mos

# Необязательно: классификатор СМИ через Anthropic API (иначе используется установленный Claude Code CLI).
# ANTHROPIC_API_KEY=
